{
  "name": "bot-sprinttrack",
  "version": "1.0.0",
  "description": "WhatsApp Bot starter template for SprintTrack Abinara-1",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "predev": "node -e \"const fs=require('fs'),path=require('path');['SingletonLock','SingletonCookie','DevToolsActivePort'].forEach(f=>{const p=path.join('.wwebjs_auth','session',f);try{if(fs.existsSync(p)){fs.unlinkSync(p);console.log('Removed: '+f);}}catch(e){}});\"",
    "dev": "tsx watch src/index.ts",
    "postinstall": "node scripts/patch-wwebjs.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
